# Optional. Without a key, deterministic static analysis remains available.
# Keep credentials on the server. Never prefix secrets with VITE_.
# NEXORA_AI_API_KEY=
# NEXORA_AI_MODEL=gpt-4.1-mini
# PORT=3001
# Required for production; use at least 12 characters.
# NEXORA_AUTH_PASSWORD=
# NEXORA_DATA_DIR=/var/lib/nexora
# Optional signed GitHub push / pull request analysis.
# NEXORA_GITHUB_WEBHOOK_SECRET=
# Optional raw GitHub read token for private repositories on your hosting provider.
# NEXORA_GITHUB_TOKEN=
